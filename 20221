<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Chatbot - OpenAI API</title>
    <style>
        /* CSS 스타일링 */
        body {
            font-family: 'Pretendard', -apple-system, sans-serif;
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .chat-container {
            width: 450px;
            height: 700px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 12px 28px rgba(0,0,0,0.12);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        header {
            background: #202123;
            color: white;
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .chat-window {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
            background: #ffffff;
        }

        .message {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.5;
            word-break: break-word;
        }

        .user {
            align-self: flex-end;
            background-color: #007bff;
            color: white;
            border-bottom-right-radius: 2px;
        }

        .ai {
            align-self: flex-start;
            background-color: #f1f1f1;
            color: #333;
            border-bottom-left-radius: 2px;
        }

        .loading {
            font-style: italic;
            color: #888;
            font-size: 12px;
        }

        .input-area {
            display: flex;
            padding: 20px;
            background: white;
            border-top: 1px solid #eee;
        }

        #user-input {
            flex: 1;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            outline: none;
            transition: border 0.3s;
        }

        #user-input:focus {
            border-color: #007bff;
        }

        #send-btn {
            margin-left: 10px;
            padding: 10px 18px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

        #send-btn:disabled {
            background: #ccc;
        }
    </style>
</head>
<body>

<div class="chat-container">
    <header>AI Assistant</header>
    <div id="chat-window" class="chat-window">
        <div class="message ai">안녕하세요! 무엇을 도와드릴까요?</div>
    </div>
    <div class="input-area">
        <input type="text" id="user-input" placeholder="질문을 입력하세요..." autocomplete="off">
        <button id="send-btn">전송</button>
    </div>
</div>

<script>
    // --- 설정 구역 ---
    const API_KEY = 'YOUR_OPENAI_API_KEY_HERE'; // <--- 여기에 API 키를 넣으세요
    const API_URL = 'https://api.openai.com/v1/chat/completions';

    const chatWindow = document.getElementById('chat-window');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');

    // 메시지 화면 출력 함수
    function addMessage(text, sender) {
        const messageDiv = document.createElement('div');
        messageDiv.classList.add('message', sender);
        messageDiv.innerText = text;
        chatWindow.appendChild(messageDiv);
        chatWindow.scrollTop = chatWindow.scrollHeight;
        return messageDiv;
    }

    // OpenAI API 호출 함수
    async function fetchAIResponse(prompt) {
        const response = await fetch(API_URL, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${API_KEY}`
            },
            body: JSON.stringify({
                model: "gpt-3.5-turbo", // 또는 "gpt-4"
                messages: [{ role: "user", content: prompt }],
                temperature: 0.7
            })
        });

        if (!response.ok) {
            throw new Error('API 호출 오류가 발생했습니다.');
        }

        const data = await response.json();
        return data.choices[0].message.content;
    }

    // 전송 로직
    async function handleSend() {
        const text = userInput.value.trim();
        if (!text || sendBtn.disabled) return;

        // 1. 사용자 메시지 추가
        addMessage(text, 'user');
        userInput.value = "";
        
        // 2. 버튼 비활성화 및 로딩 표시
        sendBtn.disabled = true;
        const loadingMsg = addMessage("생각 중...", 'ai');
        loadingMsg.classList.add('loading');

        try {
            // 3. API 호출
            const aiResponse = await fetchAIResponse(text);
            
            // 4. 로딩 메시지 제거 후 AI 답변 추가
            loadingMsg.remove();
            addMessage(aiResponse, 'ai');
        } catch (error) {
            loadingMsg.innerText = "오류: " + error.message;
            console.error(error);
        } finally {
            sendBtn.disabled = false;
        }
    }

    // 이벤트 리스너
    sendBtn.addEventListener('click', handleSend);
    userInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') handleSend();
    });
</script>

</body>
</html>
